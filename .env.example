# 复制为 .env 后按需修改；src/config.py 会自动加载项目根目录下的 .env

# 数据库连接串
# 本地零安装模式（默认）：留空即使用 SQLite
# SQLite 默认路径：data/warehouse/commerce.db
# DATABASE_URL=sqlite:///data/warehouse/commerce.db

# PostgreSQL / Docker 模式
# DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce

# 原始数据目录（相对项目根目录）
RAW_DATA_DIR=data/raw

# 是否导入 100 万行地理表（体积大，默认关闭）
LOAD_GEOLOCATION=false

# 趋势类分析的时间窗（Olist 首尾月份数据不完整，默认剔除）
ANALYSIS_START_DATE=2017-01-01
ANALYSIS_END_DATE=2018-08-31
